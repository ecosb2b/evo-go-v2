      "parameters": {
        "jsCode": "const ctx = $('Gerar Token (Go)').item.json;\nconst targetId = ctx.instanceId;\nconst targetName = ctx.instanceName;\nconst response = $json;\n\nlet list = response;\nif (!Array.isArray(list)) {\n  list = response.data || response.instances || response.result || Object.values(response)[0];\n}\n\nif (!Array.isArray(list)) {\n  return { json: { ...ctx, found: false, connected: false, has_proxy: false } };\n}\n\nconst found = list.find(inst => {\n  const id = inst.id || inst.Id || inst.ID;\n  const name = inst.name || inst.Name || inst.instanceName;\n  return id === targetId || name === targetName;\n});\n\nif (!found) {\n  return { json: { ...ctx, found: false, connected: false, has_proxy: false } };\n}\n\nconst connected = found.connected === true || found.connected === 'true' ||\n  String(found.state || found.status || '').toLowerCase() === 'open';\n\n// Instance.Proxy (json:\"proxy\") no model Go: string vazia quando nao ha proxy configurado.\n// Checamos os nomes de campo mais prováveis, ja que /instance/all devolve o Instance model cru.\nconst proxyRaw = found.proxy ?? found.Proxy ?? '';\nconst hasProxy = typeof proxyRaw === 'string' ? proxyRaw.trim() !== '' : !!proxyRaw;\n\nreturn { json: { ...ctx, found: true, connected, has_proxy: hasProxy } };"
