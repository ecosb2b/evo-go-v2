      "id": "14423232-b3fd-45af-90c9-294494eb2121",
      "name": "Re-Checar Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -48,
        1392
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Recupera dados\nconst dbData = $('Loop Instâncias').item.json;\nconst apiData = $json;\n\n// --- CONFIGURAÇÕES ---\nconst HORA_INICIO = 8;\nconst HORA_FIM = 18;\nconst INTERVALO_MINUTOS = 120; // 2 Horas\nconst MAX_TENTATIVAS_AUTO_FIX = 3;\n\n// 1. Status Atual\nlet currentStatus = 'unknown';\nif (apiData.instance && apiData.instance.state) currentStatus = apiData.instance.state;\nelse if (apiData.state) currentStatus = apiData.state;\nelse if (apiData.status) currentStatus = apiData.status;\n\ncurrentStatus = String(currentStatus).toLowerCase();\n\n// 2. Define se está online\nconst isOnline = ['open', 'connected', 'online'].includes(currentStatus);\n\n// 3. Tratamento de Tempo e Tentativas\nconst now = new Date();\nconst lastNotifString = dbData.last_notification_at;\nlet tentativas = parseInt(dbData.auto_fix_attempts || 0);\n\nlet minutosDesdeUltima = 999999;\nif (lastNotifString) {\n    const lastDate = new Date(lastNotifString);\n    if (!isNaN(lastDate.getTime())) {\n        const diffMs = now.getTime() - lastDate.getTime();\n        minutosDesdeUltima = Math.floor(diffMs / 1000 / 60);\n    }\n}\n\n// 4. DECISÃO\nlet shouldNotify = false;\nlet statusMessage = \"DESCONHECIDO\";\nlet motivoBloqueio = \"\";\n\nif (isOnline) {\n    shouldNotify = false;\n    statusMessage = \"CONECTADO\";\n    tentativas = 0; // Reseta contador se voltar a funcionar\n    motivoBloqueio = \"Está online\";\n} else {\n    statusMessage = (currentStatus === 'connecting') ? \"FALHA (TENTANDO CONECTAR)\" : \"DESCONECTADO\";\n    \n    // Incrementa tentativa se vier da rota de auto-fix (Limpeza de Redis)\n    // Se o nó anterior foi o \"Re-Checar Status\", significa que houve uma tentativa de correção\n    tentativas++;\n\n    // Regra de Notificação:\n    // Avisa se (Já passou o intervalo de 2h) OU (Já tentou 3 vezes o auto-fix e continua OFF)\n    if (minutosDesdeUltima >= INTERVALO_MINUTOS || tentativas >= MAX_TENTATIVAS_AUTO_FIX) {\n        shouldNotify = true;\n        motivoBloqueio = tentativas >= MAX_TENTATIVAS_AUTO_FIX ? \"Excedeu tentativas de auto-fix\" : \"Intervalo de tempo atingido\";\n    } else {\n        shouldNotify = false;\n        motivoBloqueio = `Auto-fix em andamento (Tentativa ${tentativas})`;\n    }\n}\n\nreturn {\n  json: {\n    ...dbData,       \n    current_status_api: currentStatus,\n    status_msg_pt: statusMessage,\n    auto_fix_attempts: tentativas,\n    now_iso: now.toISOString(),\n    shouldNotify: shouldNotify,\n    debug_motivo: motivoBloqueio\n  }\n};"
      },
      "id": "e42a3437-3742-476e-9cfa-4c71f6e7bcf5",
      "name": "Avaliar Lógica",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        1472
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE evolution_instance_monitor\nSET\n  last_status = $1,\n  auto_fix_attempts = $5,\n  updated_at = $2,\n  last_status_change_at = CASE\n    WHEN last_status IS DISTINCT FROM $1 THEN $2\n    ELSE last_status_change_at\n  END,\n  last_notification_at = CASE\n    WHEN $3::boolean IS TRUE THEN $2\n    ELSE last_notification_at\n  END,\n  last_notification_status = CASE\n    WHEN $3::boolean IS TRUE THEN $1\n    ELSE last_notification_status\n  END\nWHERE id = $4\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [ $json.current_status_api, $json.now_iso, $json.shouldNotify, $json.id, ($json.auto_fix_attempts || 0) ] }}"
        }
      },
