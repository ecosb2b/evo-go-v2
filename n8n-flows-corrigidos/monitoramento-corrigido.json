      "parameters": {
        "jsCode": "const s = $('Avaliar Lógica').item.json;\nconst tentativas = s.auto_fix_attempts || 0;\nconst statusMsg = (s.status_msg_pt || s.status || 'DESCONHECIDO').toString().trim();\nconst instance = s.instance_name;\n\nconst texto =\n  `⚠️ 🚨 *Alerta de Instância* 🚨\\n` +\n  `A instância *${instance}* está com status: *${statusMsg}*.\\n \\n` +\n  `🛠️ *Ações realizadas:* Fizemos ${tentativas} tentativas de recuperação automática (Redis Flush + Restart).\\n` +\n  `❌ *Resultado:* Sem sucesso até o momento.\\n \\n` +\n  `👉 *Ação necessária:* Verifique o dispositivo ou reconecte pelo link:\\n` +\n  `https://n8n.athenesistemas.com.br/webhook/.../${instance}`;\n\nreturn {\n  json: {\n    ...s,\n    notify_text: texto,\n    notify_whatsapp_number: s.notify_number_final,\n    notify_email: s.notify_email\n  }\n};"
      },
