    {
      "parameters": {
        "jsCode": "// Verifica se o Evolution realmente aplicou a porta esperada.\n// [Athene] Leitura da porta adaptada por versão:\n//   v2 -> resp.proxy.proxy.port | resp.proxy.port\n//   go -> resp.data.port  (o fork ecoa exatamente a porta enviada)\nconst s = $('Avaliar Hub').item.json;\nconst resp = $json;\nconst tipo = String($('Init Tentativa').first().json.evo_tipo || 'v2');\nlet aplicada;\nif (tipo === 'go') {\n  aplicada = Number(resp?.data?.port ?? 0);\n} else {\n  aplicada = Number(resp?.proxy?.proxy?.port ?? resp?.proxy?.port ?? 0);\n}\nconst esperada = Number(s.porta || 0);\nconst ok = !resp.error && esperada > 0 && aplicada === esperada;\nconst motivo = ok ? null : 'Evolution não aplicou o Proxy';\nreturn { json: {\n  success: ok,\n  porta: ok ? esperada : 0,\n  empresa_id: s.empresa_id,\n  maquina_nome: s.maquina_nome,\n  tentativas_usadas: s.tentativa,\n  motivo_falha: motivo,\n  erro_formatado: ok ? null : '[' + (s.empresa_id || 'Desconhecida') + ' - ' + (s.maquina_nome || 'Desconhecida') + '] ' + motivo\n} };"
      },
      "name": "Montar Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3664,
        32
      ],
      "id": "d79860b8-1a3d-40e0-856a-aa2293912540"
    },
    {
      "parameters": {
        "jsCode": "// Proxy morto: avisa o Hub para tirar essa porta de rotação.\nconst s = $('Avaliar Hub').item.json;\nconst SECRET_KEY = $env.ATHENE_SECRET_KEY;\nif (!SECRET_KEY) throw new Error('ATHENE_SECRET_KEY nao definida nas variaveis de ambiente do n8n.');\nconst timestamp = Date.now().toString();\nconst dataObj = { porta: s.porta || 0 };\nconst dataStr = JSON.stringify(dataObj);\nconst crypto = require('crypto');\nconst signature = crypto.createHmac('sha256', SECRET_KEY).update(timestamp + dataStr).digest('hex');\nreturn { json: { ...s, req_body: { data: dataStr, timestamp: parseInt(timestamp), signature } } };"
      },
