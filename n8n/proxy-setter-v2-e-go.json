      "parameters": {
        "jsCode": "// Junta o estado do loop (tentativa etc.) com a resposta do Hub.\nconst s = $('HMAC Proxy Ideal').item.json;\nconst resp = $json;\nconst hub_erro = !!resp.error;\nconst porta = Number(resp?.proxy?.porta || 0);\nreturn { json: {\n  instance: s.instance,\n  apikey: s.apikey,\n  limite_envios: s.limite_envios,\n  tentativa: s.tentativa,\n  max_tentativas: s.max_tentativas,\n  tentativas_mesma_empresa: s.tentativas_mesma_empresa,\n  hub_erro,\n  porta,\n  empresa_id: resp?.proxy?.empresa_id ?? null,\n  maquina_nome: resp?.proxy?.maquina_nome ?? null\n} };"
      },
