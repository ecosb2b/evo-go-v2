    {
      "parameters": {
        "jsCode": "// Estado inicial do loop de tentativas.\n// [Athene] Agora compatível com Evolution v2 E Evolution Go.\n//\n// O fluxo PAI deve passar:\n//   instance      -> (v2) nome da instância | (go) usado só para log/URL v2\n//   apikey        -> (v2) token da instância | (go) GLOBAL API KEY (AuthAdmin)\n//   evo_tipo      -> 'v2' (default) ou 'go'\n//   instance_id   -> (go) UUID da instância (obrigatório p/ Go)\n//   evo_base_url  -> base da API (default = domínio v2). Ex Go: https://evogo.seu-dominio\n//\n// Compatibilidade: sem evo_tipo/evo_base_url o comportamento é o v2 de antes.\nreturn { json: {\n  instance: $json.instance,\n  apikey: $json.apikey || $env.ATHENE_EVO_APIKEY || '',\n  evo_tipo: String($json.evo_tipo || 'v2').toLowerCase(),\n  instance_id: $json.instance_id || $json.instanceId || '',\n  evo_base_url: String($json.evo_base_url || $env.ATHENE_EVO_BASE_URL || 'https://evo.athenesistemas.com.br').replace(/\\/+$/, ''),\n  limite_envios: Number($json.limite_envios || 50),\n  tentativa: 1,\n  max_tentativas: 5,\n  tentativas_mesma_empresa: 3\n} };"
      },
      "name": "Init Tentativa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        272
      ],
      "id": "aa170466-d856-47d8-8f8e-0368b20602ce"
    },
    {
      "parameters": {
        "jsCode": "const SECRET_KEY = $env.ATHENE_SECRET_KEY;\nif (!SECRET_KEY) throw new Error('ATHENE_SECRET_KEY nao definida nas variaveis de ambiente do n8n.');\nconst s = $json;\nconst timestamp = Date.now().toString();\nconst dataObj = { limite_envios: s.limite_envios, instance: s.instance };\n// Tentativas 1..tentativas_mesma_empresa priorizam a MESMA empresa_id da última vez\n// (consistência de IP de saída = menor risco de o WhatsApp desconfiar do número).\n// Depois disso, o Hub escolhe livremente (geo/carga).\nif (s.tentativa <= s.tentativas_mesma_empresa) dataObj.preferir_mesma_empresa = true;\nconst dataStr = JSON.stringify(dataObj);\nconst crypto = require('crypto');\nconst signature = crypto.createHmac('sha256', SECRET_KEY).update(timestamp + dataStr).digest('hex');\nreturn { json: { ...s, req_body: { data: dataStr, timestamp: parseInt(timestamp), signature } } };"
      },
