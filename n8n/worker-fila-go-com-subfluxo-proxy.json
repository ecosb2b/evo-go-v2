    {
      "parameters": {
        "jsCode": "const targetName = $('Set BaseURL1').item.json.instance;\nconst response = $json;\n\n// A API pode devolver array direto ou dentro de uma chave (instances/data/result)\nlet list = response;\nif (!Array.isArray(list)) {\n  list = response.instances || response.data || response.result || Object.values(response)[0];\n}\nif (!Array.isArray(list)) {\n  throw new Error('Não achei a lista de instâncias no retorno de /instance/all: ' + JSON.stringify(response).slice(0, 500));\n}\n\nconst found = list.find(inst => {\n  const name = inst.name || inst.instanceName || inst.instance || inst.Instance || inst.nome;\n  return name === targetName;\n});\n\nif (!found) {\n  throw new Error(`Instância \"${targetName}\" não encontrada em /instance/all`);\n}\n\nconst instanceId = found.id || found.instanceId || found.Id || found.ID || found.uuid;\n\nif (!instanceId) {\n  throw new Error('Instância achada mas nenhum campo de ID reconhecido: ' + JSON.stringify(found));\n}\n\nreturn {\n  json: {\n    ...$('Set BaseURL1').item.json,\n    instanceId\n  }\n};"
