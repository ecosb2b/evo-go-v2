      "parameters": {
        "jsCode": "let items = $input.all();\n\n// Se houver mais de 5 mensagens reservadas no lote atual, embaralha a ordem de envio\nif (items.length > 5) {\n    // Algoritmo de Fisher-Yates para garantir um embaralhamento perfeito e aleatório\n    for (let i = items.length - 1; i > 0; i--) {\n        const j = Math.floor(Math.random() * (i + 1));\n        // Troca os itens de lugar\n        [items[i], items[j]] = [items[j], items[i]];\n    }\n}\n\nreturn items;"
      },
