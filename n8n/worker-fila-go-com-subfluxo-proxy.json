        "query": "UPDATE public.whatsapp_outbox o\nSET\n  status         = 'SENT',\n  sent_at        = COALESCE(o.sent_at, NOW()),\n  last_error     = NULL,\n  provider_msg_id = CASE\n    WHEN o.provider_msg_id IS NOT NULL THEN o.provider_msg_id\n    WHEN EXISTS (\n      SELECT 1 FROM public.whatsapp_outbox x\n      WHERE x.provider_msg_id = $2 AND x.id <> $1::uuid\n    ) THEN o.provider_msg_id\n    ELSE $2\n  END\nWHERE o.id = $1::uuid\n  AND o.status IN ('SENDING','RETRY','QUEUED')\nRETURNING o.id, o.provider_msg_id;",
