      "parameters": {
        "jsCode": "// Incrementa o contador de envios da porta usada (proxy-increment).\n// A porta agora vem do subfluxo de proxy (Aplicar Proxy (Sub) -> porta).\nconst SECRET_KEY = $env.ATHENE_SECRET_KEY;\nif (!SECRET_KEY) throw new Error('ATHENE_SECRET_KEY nao definida nas variaveis de ambiente do n8n.');\nconst port = Number($('Aplicar Proxy (Sub)').item.json.porta || 0);\nconst timestamp = Date.now().toString();\nconst dataObj = { porta: port, instance: $('Set BaseURL1').item.json.instance };\nconst dataStr = JSON.stringify(dataObj);\nconst crypto = require('crypto');\nconst signature = crypto.createHmac('sha256', SECRET_KEY).update(timestamp + dataStr).digest('hex');\n\nreturn { json: { req_body: { data: dataStr, timestamp: parseInt(timestamp), signature } } };"
      },
