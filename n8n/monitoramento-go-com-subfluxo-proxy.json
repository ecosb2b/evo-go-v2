    {
      "parameters": {
        "jsCode": "const dbData = $('Loop Instâncias (Go)').item.json;\nconst targetName = dbData.instance_name;\nconst response = $json;\n\nlet list = response;\nif (!Array.isArray(list)) {\n  list = response.data || response.instances || response.result || Object.values(response)[0];\n}\n\nif (!Array.isArray(list)) {\n  return { json: { ...dbData, found: false, connected: false, instanceId: null, numero_instancia: '', current_status_api: 'formato_inesperado' } };\n}\n\nconst found = list.find(inst => {\n  const name = inst.name || inst.instanceName || inst.instance || inst.Instance || inst.nome;\n  return name === targetName;\n});\n\nif (!found) {\n  return { json: { ...dbData, found: false, connected: false, instanceId: null, numero_instancia: '', current_status_api: 'nao_encontrada' } };\n}\n\nconst instanceId = found.id || found.instanceId || found.Id || found.ID || found.uuid || null;\nconst connected = found.connected === true || found.connected === 'true' ||\n  String(found.state || found.status || '').toLowerCase() === 'open';\n\n// Número da própria instância, extraído do JID (ex.: \"556292573164:62@s.whatsapp.net\" -> \"556292573164\")\nconst rawJid = found.jid || found.Jid || found.JID || '';\nconst numero_instancia = String(rawJid).split(/[:@]/)[0].replace(/\\D/g, '');\n\nreturn {\n  json: {\n    ...dbData,\n    found: true,\n    connected,\n    instanceId,\n    numero_instancia,\n    current_status_api: connected ? 'connected' : 'disconnected'\n  }\n};"
      },
