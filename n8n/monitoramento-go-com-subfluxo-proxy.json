    {
      "parameters": {
        "jsCode": "// FIX: a versão original deste node (\"Montar Msg\") montava o texto mas nunca dava \"return\",\n// então \"Tem WhatsApp?\"/\"Tem E-mail?\"/\"Enviar WhatsApp\"/\"Enviar Email\" ficavam sem dado (bug\n// pré-existente no fluxo antigo). Aqui devolvemos o json com notify_text/notify_whatsapp_number/\n// notify_email explicitamente, propagando os campos que já vêm de evolution_instance_monitor (c.*).\nconst s = $('Avaliar Lógica (Go)').item.json;\nconst tentativas = s.auto_fix_attempts || 0;\nconst statusMsg = (s.status_msg_pt || 'DESCONHECIDO').toString().trim();\nconst instance = s.instance_name;\n\nconst texto =\n  `⚠️ 🚨 *Alerta de Instância (Evo Go)* 🚨\\n` +\n  `A instância *${instance}* está com status: *${statusMsg}*.\\n \\n` +\n  `🛠️ *Ações realizadas:* Fizemos ${tentativas} tentativa(s) de recuperação automática (Force Reconnect).\\n` +\n  `❌ *Resultado:* Sem sucesso até o momento.\\n \\n` +\n  `👉 *Ação necessária:* Verifique o dispositivo ou reconecte pelo painel.`;\n\nreturn {\n  json: {\n    ...s,\n    notify_text: texto,\n    notify_whatsapp_number: s.notify_number_final,\n    notify_email: s.notify_email\n  }\n};"
      },
