    {
      "parameters": {
        "jsCode": "// Cruza a linha do banco (Loop Instâncias (Go)) com a lista de /instance/all\n// (Evo Go não tem endpoint de connectionState por instância documentado no swagger\n// com schema estável, então usamos o campo booleano \"connected\" que /instance/all\n// já expõe - o mesmo campo que \"Resolver Instance ID\" usa em send-message-go/worker-fila-go)\nconst dbData = $('Loop Instâncias (Go)').item.json;\nconst targetName = dbData.instance_name;\nconst response = $json;\n\nlet list = response;\nif (!Array.isArray(list)) {\n  list = response.data || response.instances || response.result || Object.values(response)[0];\n}\n\nif (!Array.isArray(list)) {\n  // Resposta fora do formato esperado - não derruba o monitor, só marca como \"não encontrada\"\n  return { json: { ...dbData, found: false, connected: false, instanceId: null, current_status_api: 'formato_inesperado' } };\n}\n\nconst found = list.find(inst => {\n  const name = inst.name || inst.instanceName || inst.instance || inst.Instance || inst.nome;\n  return name === targetName;\n});\n\nif (!found) {\n  return { json: { ...dbData, found: false, connected: false, instanceId: null, current_status_api: 'nao_encontrada' } };\n}\n\nconst instanceId = found.id || found.instanceId || found.Id || found.ID || found.uuid || null;\nconst connected = found.connected === true || found.connected === 'true' ||\n  String(found.state || found.status || '').toLowerCase() === 'open';\n\nreturn {\n  json: {\n    ...dbData,\n    found: true,\n    connected,\n    instanceId,\n    current_status_api: connected ? 'connected' : 'disconnected'\n  }\n};"
      },
      "id": "6a8623b8-4e79-4355-8581-67d467d38a0e",
      "name": "Resolver Status Go (Recheck)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6320,
        2016
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Mesma lógica de decisão do fluxo original (Evolution API), adaptada:\n// currentStatus/isOnline agora vêm do \"connected\" já resolvido por Resolver Status Go\n// (não existe mais parsing de instance.state/status cru da Evolution antiga).\nconst dbData = $json;\n\nconst HORA_INICIO = 8;\nconst HORA_FIM = 18;\nconst INTERVALO_MINUTOS = 120; // 2 Horas\nconst MAX_TENTATIVAS_AUTO_FIX = 3;\n\nconst currentStatus = dbData.current_status_api || 'unknown';\nconst isOnline = dbData.connected === true;\n\nconst now = new Date();\nconst lastNotifString = dbData.last_notification_at;\nlet tentativas = parseInt(dbData.auto_fix_attempts || 0);\n\nlet minutosDesdeUltima = 999999;\nif (lastNotifString) {\n    const lastDate = new Date(lastNotifString);\n    if (!isNaN(lastDate.getTime())) {\n        const diffMs = now.getTime() - lastDate.getTime();\n        minutosDesdeUltima = Math.floor(diffMs / 1000 / 60);\n    }\n}\n\nlet shouldNotify = false;\nlet statusMessage = \"DESCONHECIDO\";\nlet motivoBloqueio = \"\";\n\nif (isOnline) {\n    shouldNotify = false;\n    statusMessage = \"CONECTADO\";\n    tentativas = 0;\n    motivoBloqueio = \"Está online\";\n} else {\n    statusMessage = (currentStatus === 'nao_encontrada') ? \"NAO ENCONTRADA NA API\" : \"DESCONECTADO\";\n    tentativas++;\n\n    if (minutosDesdeUltima >= INTERVALO_MINUTOS || tentativas >= MAX_TENTATIVAS_AUTO_FIX) {\n        shouldNotify = true;\n        motivoBloqueio = tentativas >= MAX_TENTATIVAS_AUTO_FIX ? \"Excedeu tentativas de auto-fix\" : \"Intervalo de tempo atingido\";\n    } else {\n        shouldNotify = false;\n        motivoBloqueio = `Auto-fix em andamento (Tentativa ${tentativas})`;\n    }\n}\n\nreturn {\n  json: {\n    ...dbData,\n    current_status_api: currentStatus,\n    status_msg_pt: statusMessage,\n    auto_fix_attempts: tentativas,\n    now_iso: now.toISOString(),\n    shouldNotify: shouldNotify,\n    debug_motivo: motivoBloqueio\n  }\n};"
      },
      "id": "4ad810d4-f760-45d2-8a1f-b65ded550757",
      "name": "Avaliar Lógica (Go)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6544,
        2400
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE evolution_instance_monitor\nSET\n  last_status = $1,\n  auto_fix_attempts = $5,\n  updated_at = $2,\n  last_status_change_at = CASE\n    WHEN last_status IS DISTINCT FROM $1 THEN $2\n    ELSE last_status_change_at\n  END,\n  last_notification_at = CASE\n    WHEN $3::boolean IS TRUE THEN $2\n    ELSE last_notification_at\n  END,\n  last_notification_status = CASE\n    WHEN $3::boolean IS TRUE THEN $1\n    ELSE last_notification_status\n  END\nWHERE id = $4\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [ $json.current_status_api, $json.now_iso, $json.shouldNotify, $json.id, ($json.auto_fix_attempts || 0) ] }}"
        }
      },
