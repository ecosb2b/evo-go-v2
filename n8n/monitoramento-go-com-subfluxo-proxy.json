      "parameters": {
        "jsCode": "// [Athene] Monta o payload para o SUBFLUXO reutilizável de proxy\n// (proxy-setter-v2-e-go), na variante Evo Go.\n// Lê a instância da iteração atual do loop via paired-item.\nconst r = $('Resolver Status Go').item.json;\nreturn { json: {\n  instance: r.instance_name,\n  instance_id: r.instanceId,\n  apikey: 'porv@2024Pc2Info',\n  evo_tipo: 'go',\n  evo_base_url: 'https://evogo.athenesistemas.com.br',\n  limite_envios: 50\n} };"
